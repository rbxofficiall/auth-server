# Copy this file to ".env" and edit.
# Port the server listens on (0.0.0.0:<PORT>).
PORT=3000
# Secret token required for all /api/admin/* calls (header X-Admin-Token).
ADMIN_TOKEN=change-this-admin-token
# Base URL used by admin.js (defaults to http://127.0.0.1:$PORT).
# BASE_URL=https://your-host.example.com
